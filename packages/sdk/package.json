{
  "name": "@callpad-sdk/core",
  "version": "0.1.0",
  "description": "Headless SDK for Gopaddi audio/video",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "generate:api": "openapi-ts",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "author": "Voyatek Group",
  "repository": {
    "type": "git"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "livekit-client": "^2.8.0",
    "socket.io-client": "^4.7.0",
    "axios": "^1.6.0",
    "jwt-decode": "^4.0.0",
    "zustand": "^4.5.0",
    "immer": "^10.0.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.37.0",
    "tsup": "^8.0.0",
    "typescript": "^5.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}