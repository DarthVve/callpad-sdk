{
  "name": "vg-x07df",
  "version": "1.0.2",
  "description": "Headless SDK for dubadav audio/video",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./livekit": {
      "types": "./dist/livekit/index.d.ts",
      "import": "./dist/livekit/index.mjs",
      "require": "./dist/livekit/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:api": "openapi-ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"Lint not configured - add ESLint setup\"",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck"
  },
  "author": "Voyatek Group",
  "repository": {
    "type": "git",
    "url": "https://github.com/VoyatekGroup/go-callpad.git",
    "directory": "web-sdk/packages/sdk"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "livekit-client": "^2.8.0",
    "socket.io-client": "^4.7.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "livekit-client": {
      "optional": false
    },
    "socket.io-client": {
      "optional": false
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "jwt-decode": "^4.0.0",
    "zustand": "^4.5.0",
    "immer": "^10.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.37.0",
    "tsup": "^8.0.0",
    "typescript": "^5.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "livekit-client": "^2.8.0",
    "socket.io-client": "^4.7.0",
    "rimraf": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}